# ─── Slack (create an app at api.slack.com, install to workspace) ───────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...            # only if using Socket Mode; HTTP mode uses signing secret
SPARK_CLIP_CHANNEL=C0123456789     # dedicated channel id (optional)

# ─── Gemini (Google AI Studio API key) ─────────────────────────────────────
GEMINI_API_KEY=...
GEMINI_TEXT_MODEL=gemini-flash-latest       # "-latest" alias avoids retired dated model IDs (e.g. gemini-2.5-flash)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # or a Nano Banana 2 / 3 image model

# ─── Higgsfield ────────────────────────────────────────────────────────────
HIGGSFIELD_CREDENTIALS=KEY_ID:KEY_SECRET
HIGGSFIELD_ENDPOINT=/higgsfield-ai/dop/standard   # model_id goes directly off the API root, no /v1/image2video/ prefix
HIGGSFIELD_DEFAULT_MODEL=higgsfield-ai/dop/standard   # Seedance 2.0 is not enabled for API access on this account; DoP Standard is
HIGGSFIELD_WEBHOOK_SECRET=change-me
PUBLIC_BASE_URL=https://spark.veyrastudios.agency  # subdomain pointing to same VPS, port 3001

# ─── Notion ────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...              # the "Spark Clip Projects" database id

# ─── Google Drive (service account) ────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gdrive-service-account.json
GDRIVE_PARENT_FOLDER_ID=...        # parent folder shared with the service account email

# ─── App ───────────────────────────────────────────────────────────────────
PORT=3001
CLIPS_PER_VIDEO=3
TOTAL_VIDEOS=5
DB_PATH=./data/spark-clip.db
